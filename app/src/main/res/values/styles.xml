<resources>

  <!-- The OS draws this before the saved in-app theme is available. -->
  <style name="SplashTheme" parent="Theme.SplashScreen">
    <item name="windowSplashScreenBackground">#06060B</item>
    <item name="windowSplashScreenAnimatedIcon">@drawable/notification_brand</item>
    <item name="postSplashScreenTheme">@style/AppTheme</item>
    <item name="android:windowBackground">#06060B</item>
    <item name="android:colorBackground">#06060B</item>
    <item name="android:statusBarColor">#06060B</item>
    <item name="android:navigationBarColor">#06060B</item>
    <item name="android:windowLightStatusBar">false</item>
  </style>

  <style name="IrohaConnectTheme" parent="AppTheme" />

</resources>
