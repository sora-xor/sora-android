<resources>

  <!-- The OS draws this before the saved in-app theme is available. -->
  <style name="SplashTheme" parent="Theme.SplashScreen">
    <item name="windowSplashScreenBackground">@color/launch_page</item>
    <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    <item name="postSplashScreenTheme">@style/AppTheme</item>
    <item name="android:windowBackground">@color/launch_page</item>
    <item name="android:colorBackground">@color/launch_page</item>
    <item name="android:statusBarColor">@color/launch_page</item>
    <item name="android:navigationBarColor">@color/launch_page</item>
    <item name="android:windowLightStatusBar">true</item>
  </style>

  <style name="IrohaConnectTheme" parent="AppTheme" />

</resources>
