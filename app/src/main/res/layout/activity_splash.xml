<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/splashContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/launch_page">

    <!--
      The launch scene (TenmonFlight): the mark comes down onto the light launch page and rings of
      mother of pearl spread under it. It fills the window, under everything else on this screen.
    -->
    <FrameLayout
        android:id="@+id/launchScene"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="noHideDescendants"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Slow start (design spec 8.1): ink on the light launch page, then a thin red line. -->
    <TextView
        android:id="@+id/loadingDisclaimerTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/x4"
        android:visibility="gone"
        android:fontFamily="@font/inter_regular"
        android:gravity="center"
        android:textSize="14sp"
        android:textColor="@color/launch_ink"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias=".8"
        android:text="@string/launch_screen_loading_title"/>

    <ProgressBar
        android:id="@+id/loadingProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="120dp"
        android:layout_height="4dp"
        android:layout_marginTop="@dimen/x2"
        android:indeterminate="true"
        android:indeterminateTint="@color/launch_red"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@+id/loadingDisclaimerTextView"
        app:layout_constraintStart_toStartOf="@+id/loadingDisclaimerTextView"
        app:layout_constraintTop_toBottomOf="@+id/loadingDisclaimerTextView" />

    <!--
      Safe Mode (design spec 9): the upgrade progress, the storage screen and the recovery
      options, drawn in Compose by SplashActivity (SORA Neon Safe Mode kit). Hidden until needed.
    -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/walletRecoveryCompose"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
