<?xml version="1.0" encoding="utf-8"?>
<!--
  SORA Neon XML mirrors, light ("Daylight") values. Dark values are in values-night/neon_colors.xml.
  Keep in sync with compose/theme/tokens/DayThemeColors.kt and compose/theme/neon/NeonTokens.kt
  (NeonLight). Used by the XML theme (styles.xml), the splash and recovery panel, and dialogs.
-->
<resources>
    <color name="neon_canvas">#F2F3F8</color>
    <color name="neon_surface">#FFFFFF</color>
    <color name="neon_surface_variant">#E9EBF2</color>
    <color name="neon_sheet">#FFFFFF</color>
    <!-- 94% chrome tint (bottom navigation) -->
    <color name="neon_chrome">#F0FFFFFF</color>
    <!-- #0B0C14 at 8% -->
    <color name="neon_hairline">#140B0C14</color>
    <color name="neon_divider">#DADCE5</color>
    <color name="neon_border_input">#7E8296</color>

    <color name="neon_text_primary">#0B0C14</color>
    <color name="neon_text_secondary">#454A5E</color>
    <color name="neon_text_tertiary">#5E6278</color>
    <color name="neon_text_disabled">#A4A8B9</color>
    <!-- Label on accent fills: white in light, ink in dark -->
    <color name="neon_on_accent">#FFFFFF</color>
    <color name="neon_link">#00708A</color>

    <color name="neon_brand_red">#C80E34</color>
    <color name="neon_cyan">#00708A</color>
    <color name="neon_polkaswap">#D6005A</color>
    <color name="neon_polkaswap_text">#B0004B</color>

    <color name="neon_success">#08704D</color>
    <color name="neon_success_container">#E3F6F0</color>
    <color name="neon_warning">#8A4F00</color>
    <color name="neon_warning_container">#FFF0DA</color>
    <color name="neon_error">#BC0E2D</color>
    <color name="neon_error_container">#F9E7EA</color>

    <!-- Safe Mode CTA (cta.safe start colour) and card border (border.safe) -->
    <color name="neon_safe_start">#08704D</color>
    <color name="neon_safe_border_start">#8008704D</color>
    <color name="neon_safe_border_end">#6600708A</color>
    <!-- Glass button fill and pressed fill on the opaque XML surfaces -->
    <color name="neon_button_secondary">#F2F3F8</color>
    <!-- cta.disabled: #0B0C14 at 6% (disabled XML buttons) -->
    <color name="neon_cta_disabled">#0F0B0C14</color>
    <!-- infoContainer: reassurance callouts (design spec 7.17) -->
    <color name="neon_info_container">#E0F8FC</color>
    <!-- bg.toast (inverted in light, design spec 7.13) and its text -->
    <color name="neon_toast">#14141F</color>
    <color name="neon_on_toast">#FFFFFF</color>
    <color name="neon_swap_end">#A3128A</color>
</resources>
