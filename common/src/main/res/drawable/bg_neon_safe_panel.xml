<?xml version="1.0" encoding="utf-8"?>
<!--
  SORA Neon SafeCard (design spec 7.3, 7.17) for XML screens: opaque surface, 24 dp corners and
  the mint-to-cyan border.safe gradient hairline. Used by the splash recovery panel.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="315"
                android:endColor="@color/neon_safe_border_end"
                android:startColor="@color/neon_safe_border_start"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="23dp" />
            <solid android:color="@color/neon_surface" />
        </shape>
    </item>
</layer-list>
