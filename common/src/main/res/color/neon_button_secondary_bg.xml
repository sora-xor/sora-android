<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget.Sora.Button.Secondary fill (design spec 7.1).
  activated + disabled = the action is running: keep the enabled look (the label says "Working…").
  disabled = another action is running, or the button is off: cta.disabled / text.disabled.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/neon_button_secondary" android:state_activated="true" />
    <item android:color="@color/neon_cta_disabled" android:state_enabled="false" />
    <item android:color="@color/neon_button_secondary" />
</selector>
