<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/clMainContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/flContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigationView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/fragmentNavHostMain"
            android:name="androidx.navigation.fragment.NavHostFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:defaultNavHost="true" />
    </FrameLayout>

    <!-- Reconnecting is routine: the notice is ink on the page's own surface, not an alarm. -->
    <TextView
        android:id="@+id/badConnectionView"
        style="@style/TextAppearance.Soramitsu.Paragraph_3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_lit_banner"
        android:gravity="center_horizontal"
        android:paddingBottom="4dp"
        android:text="@string/common_connecting"
        android:textColor="?attr/contentPrimary"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible" />

    <!-- The bar is a sheet of milk glass standing above the page: its shadow falls up over the page behind. -->
    <View
        android:id="@+id/bottomBarShadow"
        android:layout_width="0dp"
        android:layout_height="12dp"
        android:background="@drawable/bg_lit_bar_shadow"
        android:importantForAccessibility="no"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigationView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_lit_bar"
        android:visibility="gone"
        app:elevation="2dp"
        app:itemActiveIndicatorStyle="@style/SoraBottomNavSelection"
        app:itemIconTint="@drawable/bottom_navigation_icon_color_selector"
        app:itemTextAppearanceActive="@style/TextAppearance.Soramitsu.Neu.BottomNavigation"
        app:itemTextAppearanceInactive="@style/TextAppearance.Soramitsu.Neu.BottomNavigation"
        app:itemTextColor="@drawable/bottom_navigation_text_color_selector"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/bottom_navigations"
        tools:background="@color/neu_color_100"
        tools:visibility="visible" />

    <!-- The Polkaswap disc: cut red glass with the flower inlaid, and room round it for its shadow. -->
    <jp.co.soramitsu.feature_main_impl.presentation.PressAwareFrameLayout
        android:id="@+id/fabMain"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_marginBottom="12dp"
        android:clickable="true"
        android:elevation="4dp"
        android:focusable="true"
        android:outlineProvider="none"
        android:visibility="gone"
        android:contentDescription="@string/polkaswap_swap_title"
        app:layout_constraintBottom_toBottomOf="@id/bottomNavigationView"
        app:layout_constraintEnd_toEndOf="@id/bottomNavigationView"
        app:layout_constraintStart_toStartOf="@id/bottomNavigationView">
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/fabDome"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_gravity="center"
            android:elevation="4dp"
            android:importantForAccessibility="no" />
    </jp.co.soramitsu.feature_main_impl.presentation.PressAwareFrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>